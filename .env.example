# ==============================================================================
# GARMENTFLOW V2 — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Petunjuk Penggunaan:
# 1. Salin isi file ini ke 'apps/backend/.env' untuk server backend.
# 2. Salin variabel VITE_API_URL ke 'apps/frontend/.env' untuk aplikasi frontend.
# 3. Ganti seluruh nilai placeholder dengan konfigurasi lokal atau server produksi Anda.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# Format koneksi: postgresql://[user]:[password]@[host]:[port]/[database_name]
# Digunakan oleh Drizzle ORM (drizzle.config.ts) dan Postgres client backend.
DATABASE_URL=postgresql://postgres:your_strong_password@localhost:5432/inventaris_pakaian


# ------------------------------------------------------------------------------
# 2. BETTER AUTH CONFIGURATION (Autentikasi & Keamanan Sesi)
# ------------------------------------------------------------------------------
# BETTER_AUTH_SECRET: Kunci rahasia untuk menandatangani cookie sesi dan token enkripsi.
# WAJIB diubah ke string acak yang kuat (minimal 32 karakter) di lingkungan produksi.
# Anda dapat menghasilkan string acak menggunakan: `openssl rand -base64 32`
BETTER_AUTH_SECRET=your-secret-key-min-32-chars-change-in-production

# BETTER_AUTH_URL: Alamat URL lengkap tempat server backend Better Auth berjalan.
# Harus cocok dengan port server backend.
BETTER_AUTH_URL=http://localhost:3001


# ------------------------------------------------------------------------------
# 3. BACKEND SERVER CONFIGURATION (Express.js)
# ------------------------------------------------------------------------------
# PORT: Port lokal tempat REST API server Express mendengarkan permintaan HTTP.
PORT=3001

# FRONTEND_URL: Alamat origin aplikasi client frontend (React Vite).
# Sangat penting untuk konfigurasi Cross-Origin Resource Sharing (CORS)
# dan allow cookie credentials pada browser.
FRONTEND_URL=http://localhost:5173


# ==============================================================================
# 4. FRONTEND CONFIGURATION (.env untuk apps/frontend/.env)
# ==============================================================================
# VITE_API_URL: Base URL endpoint backend yang dihubungi oleh aplikasi client React.
# Nilai ini diekspos ke client bundle melalui awalan 'VITE_'.
VITE_API_URL=http://localhost:3001
